{
  "name": "proxy-monitor",
  "version": "1.10.2",
  "description": "Proxy monitoring system with Telegram alerts",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "audit": "pnpm audit --prod"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@sentry/node": "^10.78.0",
    "better-sqlite3": "^12.11.1",
    "socks": "^2.8.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
