TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CHECK_INTERVAL=45000
FAIL_THRESHOLD=4
MAX_PROXIES=100
MAX_ADD_BODY_BYTES=10000
MAX_CONCURRENT_CHECKS=10
ALLOW_PRIVATE_TARGETS=false
# 32 bytes hex key for AES-256-GCM. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Проверка ротации IP (все значения в миллисекундах)
IP_CHECK_INTERVAL=300000
# 0 — выключить проверку ротации целиком
ROTATION_MAX_AGE=2700000

# Эхо-сервисы для внешнего IP — список через запятую, только http:
IP_ECHO_URL=http://api.ipify.org,http://ifconfig.me/ip
# Сколько подряд провалов IP-пробы до алерта
IP_PROBE_FAIL_THRESHOLD=3

# Проверка доступности: основной адрес и подтверждающий запасной (только http:)
CHECK_URL=http://cp.cloudflare.com/generate_204
CHECK_URL_FALLBACK=http://www.gstatic.com/generate_204

# Внешний watchdog (healthchecks.io и совместимые), http: или https:.
# Пусто — механизм выключен. Адрес содержит секрет и не логируется.
HEALTHCHECK_URL=

# Sentry — только отчёты об ошибках. Пусто — SDK не поднимается.
SENTRY_DSN=
